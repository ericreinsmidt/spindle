# Build output. Regenerated by build.sh from Source.
*.pdx

# macOS clutter.
.DS_Store

# Python leaves these behind whenever ingest.py is imported rather than run.
__pycache__/

# The generated library is not tracked. It is hundreds of megabytes of
# converted audio produced by tools/ingest.py from your own music, and it does
# not belong in version control. Regenerate it with:
#     python3 tools/ingest.py <music folder> <output folder>
build/
library/

# Source music, if anyone ever puts it inside the project folder.
Music/
